<Page
    x:Class="CurrencyApp.Views.CurrencyListPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CurrencyApp.Models"
    Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Grid Grid.Row="0" Padding="16,12" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Курсы валют" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding LastUpdated}" FontSize="12" Foreground="#7F8C8D"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Background="#3498DB" Foreground="White"
                    CornerRadius="8" Padding="16,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="White"/>
                    <TextBlock Text="Обновить" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- ── Currency list ── -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Currencies}"
                  Padding="12,8"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,4"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Currency">
                    <Border Background="White" CornerRadius="10" Padding="16,12"
                            BorderThickness="0">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name & nominal -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                           Foreground="#2C3E50" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind NominalStr}" FontSize="11" Foreground="#95A5A6"/>
                            </StackPanel>
                            <!-- Delete button -->
                            <Button Grid.Column="4"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=PageRoot}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#E74C3C"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ── Status bar ── -->
        <Border Grid.Row="2" Background="White" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="#E0E0E0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#7F8C8D" FontSize="12"/>
        </Border>
    </Grid>
</Page>
