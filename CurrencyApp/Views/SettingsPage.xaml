<Page
    x:Class="CurrencyApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F4F8">

    <ScrollViewer>
        <StackPanel MaxWidth="540" Margin="24" Spacing="16">

            <!-- Title -->
            <TextBlock Text="Настройки" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>

            <!-- Last session card -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE787;" FontSize="18" Foreground="#3498DB"/>
                        <TextBlock Text="Сведения о сессии" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#E0E0E0"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Предыдущая сессия:" Foreground="#7F8C8D" FontSize="13"/>
                        <TextBlock Text="{Binding LastSession}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="#2C3E50"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage type card -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#3498DB"/>
                        <TextBlock Text="Тип хранилища" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#E0E0E0"/>
                    <TextBlock Text="Выберите, где сохранять данные валют:"
                               Foreground="#7F8C8D" FontSize="13" TextWrapping="Wrap"/>

                    <!-- SQLite option -->
                    <Border Background="#EBF5FB" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="SQLite" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <TextBlock Text="Реляционная база данных — currencies.db"
                                           FontSize="12" Foreground="#7F8C8D"/>
                            </StackPanel>
                            <RadioButton Grid.Column="1" IsChecked="{Binding IsSqlite, Mode=TwoWay}"
                                         GroupName="StorageGroup" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- JSON option -->
                    <Border Background="#EBF5FB" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="JSON файл" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                <TextBlock Text="Текстовый файл — currencies.json"
                                           FontSize="12" Foreground="#7F8C8D"/>
                            </StackPanel>
                            <RadioButton Grid.Column="1" IsChecked="{Binding IsJson, Mode=TwoWay}"
                                         GroupName="StorageGroup" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="⚠ Смена типа вступит в силу при следующем переходе на страницу курсов."
                               FontSize="12" Foreground="#E67E22" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- About card -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#3498DB"/>
                        <TextBlock Text="О приложении" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="#E0E0E0"/>
                    <TextBlock Text="CurrencyApp — курсы валют ЦБ РФ" FontWeight="SemiBold" Foreground="#2C3E50"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="13">
                        Данные предоставлены сервисом cbr-xml-daily.ru.
                        Архитектура: UWP + MVVM.
                        Хранилище: SQLite (sqlite-net-pcl) и JSON (Newtonsoft.Json).
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
