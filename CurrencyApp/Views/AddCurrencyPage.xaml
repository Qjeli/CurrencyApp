<Page
    x:Class="CurrencyApp.Views.AddCurrencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F4F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="540" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="28">
                <StackPanel Spacing="20">

                    <!-- Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Добавить валюту" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Заполните данные новой валюты" FontSize="13" Foreground="#7F8C8D"/>
                    </StackPanel>

                    <!-- CharCode -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Код валюты *" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox PlaceholderText="Например: USDT, GOLD, BTC"
                                 Text="{Binding CharCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Название валюты *" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox PlaceholderText="Например: Биткоин, Золото (г)"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Value -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Курс (в рублях) *" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox PlaceholderText="Например: 5840.50"
                                 Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 InputScope="Number"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Nominal -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Номинал *" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox PlaceholderText="Обычно 1"
                                 Text="{Binding NominalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 InputScope="Number"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- NumCode (optional) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Числовой код (необязательно)" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <TextBox PlaceholderText="Например: 840"
                                 Text="{Binding NumCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 CornerRadius="8"/>
                    </StackPanel>

                    <!-- Submit -->
                    <Button Command="{Binding AddCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#3498DB" Foreground="White"
                            CornerRadius="8" Padding="0,12"
                            FontSize="15" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Добавить валюту" Foreground="White"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
